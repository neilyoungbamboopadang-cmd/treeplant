<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7F5EE" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView android:id="@+id/welcomeLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="45dp" android:letterSpacing="0.15"
            android:text="WELCOME" android:textColor="#6B806B"
            android:textSize="12sp" android:textStyle="bold" />

        <TextView android:id="@+id/titleText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:gravity="center"
            android:text="Grow Together." android:textColor="#2B2B2B"
            android:textSize="28sp" android:textStyle="bold" />

        <TextView android:id="@+id/subtitleText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:gravity="center"
            android:text="A community where faith, love, and friendship come together."
            android:textColor="#444444" android:textSize="13sp" />

        <ImageView android:id="@+id/logoBackground"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="32dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo" />

        <Button android:id="@+id/btnGetStarted"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="16dp" android:backgroundTint="#6B806B"
            android:text="GET STARTED  →" android:textColor="#FFFFFF" />

        <TextView android:id="@+id/tvBegin"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:padding="8dp"
            android:text="BEGIN YOUR JOURNEY" android:textColor="#2B2B2B"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Faith  •  Love  •  Community"
            android:textColor="#B3202A" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
