<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7F5EE" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="60dp" android:text="Join Us."
            android:textColor="#2B2B2B" android:textSize="28sp" android:textStyle="bold" />
        <EditText android:id="@+id/etRegEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="40dp" android:hint="Email"
            android:inputType="textEmailAddress" />
        <EditText android:id="@+id/etRegPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Password (min. 6 characters)"
            android:inputType="textPassword" />
        <EditText android:id="@+id/etRegConfirm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Confirm password"
            android:inputType="textPassword" />
        <Button android:id="@+id/btnRegister"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="28dp" android:backgroundTint="#6B806B"
            android:text="CREATE ACCOUNT" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/tvGoLogin"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="8dp"
            android:text="Already have an account? Log in"
            android:textColor="#B3202A" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
